# YouTube MCP Server Environment Variables
# Copy this file to .env and fill in your values or set them in your MCP client config.

# Google API Key for YouTube Data API v3
GOOGLE_API_KEY=

# (Optional) OAuth Credentials for user-authenticated YouTube operations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (Optional) Custom User-Agent for yt-dlp transcript extraction
# YT_DLP_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"

